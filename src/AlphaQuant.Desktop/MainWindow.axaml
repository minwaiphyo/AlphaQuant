<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:AlphaQuant.Desktop.ViewModels"
        xmlns:views="using:AlphaQuant.Desktop.Views"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AlphaQuant.Desktop.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="AlphaQuant">
    <Window.DataTemplates>
        <DataTemplate DataType="vm:HomeViewModel">
            <views:HomeView />
        </DataTemplate>
        <DataTemplate DataType="vm:ReleaseNotesViewModel">
            <views:ReleaseNotesView />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="vm:SearchViewModel">
            <views:SearchView />
        </DataTemplate>
        <DataTemplate DataType="vm:CompanyDetailViewModel">
            <views:CompanyDetailView />
        </DataTemplate>
    </Window.DataTemplates>

    <ContentControl Content="{Binding CurrentPage}" />
</Window>
