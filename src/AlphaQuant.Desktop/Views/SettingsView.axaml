<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:AlphaQuant.Desktop.ViewModels" xmlns:views="using:AlphaQuant.Desktop.Views" x:Class="AlphaQuant.Desktop.Views.SettingsView" x:DataType="vm:SettingsViewModel">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="22">
      <TextBlock Text="Workspace / Data connections" Classes="muted small"/>
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="7">
          <TextBlock Text="KEEP YOUR SOURCES CLEAR" Classes="eyebrow"/>
          <TextBlock Text="Data connections" Classes="h1"/>
        </StackPanel>
        <Button Grid.Column="1" Content="← Return to research" Command="{Binding BackCommand}" VerticalAlignment="Center"/>
      </Grid>
      <TextBlock Text="SEC filing evidence and market prices have separate connections. Your research stays in place while you manage setup." Classes="muted"/>
      <Grid ColumnDefinitions="1.1*,*" ColumnSpacing="22">
        <Border Classes="panel">
          <StackPanel Spacing="16">
            <TextBlock Text="SEC EDGAR" Classes="h2"/>
            <TextBlock Text="FILING EVIDENCE" Classes="eyebrow"/>
            <TextBlock Text="The SEC requires automated requests to identify themselves. Use a contact email you monitor; AlphaQuant sends it in the User-Agent header of each SEC request." Classes="muted"/>
            <TextBlock Text="SEC contact email" FontWeight="SemiBold"/>
            <TextBox Text="{Binding Contact, Mode=TwoWay}" PlaceholderText="name@example.com" AutomationProperties.Name="SEC contact email">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding SaveCommand}"/>
              </TextBox.KeyBindings>
            </TextBox>
            <WrapPanel>
              <Button Content="Save" Classes="primary" Command="{Binding SaveCommand}" Margin="0,0,8,8"/>
              <Button Content="Clear saved contact" Command="{Binding ClearSavedCommand}" Margin="0,0,0,8"/>
            </WrapPanel>
            <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" TextWrapping="Wrap" IsVisible="{Binding StatusMessage, Converter={x:Static ObjectConverters.IsNotNull}}"/>
            <Border Classes="notice">
              <TextBlock Text="{Binding SourceText}" TextWrapping="Wrap"/>
            </Border>
            <TextBlock Text="Stored only on this computer:" Classes="muted small"/>
            <TextBlock Text="{Binding SettingsFile}" Classes="muted small"/>
            <TextBlock Text="This contact is separate from provider authentication. Missing or invalid contact blocks SEC requests." Classes="muted small"/>
          </StackPanel>
        </Border>
        <StackPanel Grid.Column="1" Spacing="16">
          <Border Classes="panel">
            <StackPanel Spacing="13">
              <TextBlock Text="Market-data providers" Classes="h2"/>
              <TextBlock Text="SESSION-ONLY MARKET CONNECTION" Classes="eyebrow"/>
              <TextBlock Text="Connect your eligible account through the browser. No in-app purchase, trading or paid upgrade." Classes="muted"/>
              <Border Classes="notice">
                <StackPanel Spacing="7">
                  <TextBlock Text="Alpaca" FontSize="17" FontWeight="SemiBold"/>
                  <TextBlock Text="Implemented adapter · Basic / IEX" Classes="warning small"/>
                  <TextBlock Text="Basic / IEX is the initial free evaluation route. IEX has limited venue coverage; it is not the consolidated US market. Account access and permitted use need verification." Classes="muted small"/>
                  <TextBlock Text="Browser OAuth · data-only consent · tokens stay in memory until disconnect or app exit. The app never asks for your password, API keys or application secret." Classes="muted small"/>                  <StackPanel Spacing="8" IsVisible="{Binding Market, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Text="{Binding Market.Status}" Classes="muted small" AutomationProperties.LiveSetting="Polite"/>
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding Market.Busy}" Height="3"/>
                    <WrapPanel>
                      <Button Content="Connect with Alpaca" Command="{Binding Market.ConnectCommand}" IsEnabled="{Binding Market.Configured}" Margin="0,0,8,8"/>
                      <Button Content="Test selected symbols" Command="{Binding Market.TestCommand}" Margin="0,0,8,8"/>
                      <Button Content="Cancel" Command="{Binding Market.CancelCommand}" IsVisible="{Binding Market.Busy}" Margin="0,0,8,8"/>
                      <Button Content="Disconnect" Command="{Binding Market.DisconnectCommand}" Margin="0,0,8,8"/>
                    </WrapPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border BorderBrush="{DynamicResource AqLine}" BorderThickness="1" CornerRadius="6" Padding="16">
                <StackPanel Spacing="7">
                  <TextBlock Text="Additional providers" FontWeight="SemiBold"/>
                  <TextBlock Text="Planned · No additional vendor selected" Classes="warning small"/>
                  <TextBlock Text="Future supported options may use free accounts or optional subscriptions users already own. No access or pricing is guaranteed." Classes="muted small"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
          <Border Classes="notice">
            <TextBlock Text="Financial analysis works without a price connection. Price-based valuation requires a fresh eligible trade and reviewed equity/capital evidence; unavailable results include reasons." TextWrapping="Wrap"/>
          </Border>
          <Border Classes="panel">
            <StackPanel Spacing="10">
              <TextBlock Text="Advanced reviewed JSON import" Classes="h2"/>
              <TextBlock Text="The structured review form below avoids JSON editing. Existing reviewed JSON import remains supported for this session only; parsing does not certify accuracy or fill absent zero claims." Classes="muted small"/>
              <TextBox Text="{Binding Market.EvidenceJson}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="180" MaxLength="65536" AutomationProperties.Name="Reviewed valuation evidence JSON"/>
              <WrapPanel>
                <Button Content="Load reviewed inputs" Command="{Binding Market.LoadEvidenceCommand}" Margin="0,0,8,8"/>
                <Button Content="Clear reviewed inputs" Command="{Binding Market.ClearEvidenceCommand}" Margin="0,0,8,8"/>
              </WrapPanel>
              <TextBlock Text="{Binding Market.EvidenceStatus}" Classes="muted small"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
      <ContentControl IsVisible="{Binding HasValuationReview}">
        <views:ValuationReviewView DataContext="{Binding Review}"/>
      </ContentControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
