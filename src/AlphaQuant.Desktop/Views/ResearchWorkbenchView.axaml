<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:AlphaQuant.Desktop.ViewModels" x:Class="AlphaQuant.Desktop.Views.ResearchWorkbenchView" x:DataType="vm:ResearchWorkbenchViewModel">
<Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
<TextBlock Text="Research, thesis and models" Classes="h1"/>
<StackPanel Grid.Row="1" Spacing="6"><TextBlock Text="{Binding Status}" TextWrapping="Wrap"/><WrapPanel><Button Content="Reload local history" Command="{Binding ReloadCommand}" Margin="0,0,8,4"/><Button Content="Cancel operation" Command="{Binding CancelCommand}" Margin="0,0,8,4"/></WrapPanel><ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}"/></StackPanel>
<TabControl x:Name="ResearchTabs" Grid.Row="2">
<TabItem Header="Thesis"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="12">
<TextBlock Text="Explicit saves only. User judgments remain separate from reported facts. No autosave: save before closing. Loading a saved revision explicitly replaces the editor; reloading the list preserves draft fields." TextWrapping="Wrap" Classes="muted"/>
<Button Content="Clear editor / new document (discard unsaved edits)" Command="{Binding NewDocumentCommand}" HorizontalAlignment="Left"/>
<TextBlock Text="{Binding EditingIdentity}" TextWrapping="Wrap"/>
<ComboBox ItemsSource="{Binding Revisions}" SelectedItem="{Binding SelectedRevision}" HorizontalAlignment="Stretch" AutomationProperties.Name="Research revision"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:RevisionChoice"><TextBlock Text="{Binding Label}" TextWrapping="Wrap"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
<WrapPanel><Button Content="Load selected revision into editor" Command="{Binding LoadSelectedCommand}" Margin="0,0,8,8"/><Button Content="Archive selected revision" Command="{Binding ArchiveCommand}" Margin="0,0,8,8"/><Button Content="Recover selected revision" Command="{Binding RecoverCommand}" Margin="0,0,8,8"/></WrapPanel>
<StackPanel Spacing="4"><TextBlock Text="Research title" TextWrapping="Wrap"/><TextBox Text="{Binding DocumentTitle}" AutomationProperties.Name="Research title" MaxLength="8000"/></StackPanel>
<StackPanel Spacing="4"><TextBlock Text="Thesis" TextWrapping="Wrap"/><TextBox Text="{Binding Thesis}" AutomationProperties.Name="Thesis" MaxLength="8000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="75"/></StackPanel>
<StackPanel Spacing="4"><TextBlock Text="Variant view" TextWrapping="Wrap"/><TextBox Text="{Binding VariantView}" AutomationProperties.Name="Variant view" MaxLength="8000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="75"/></StackPanel>
<StackPanel Spacing="4"><TextBlock Text="Catalysts" TextWrapping="Wrap"/><TextBox Text="{Binding Catalysts}" AutomationProperties.Name="Catalysts" MaxLength="8000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="75"/></StackPanel>
<StackPanel Spacing="4"><TextBlock Text="Risks" TextWrapping="Wrap"/><TextBox Text="{Binding Risks}" AutomationProperties.Name="Risks" MaxLength="8000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="75"/></StackPanel>
<StackPanel Spacing="4"><TextBlock Text="Invalidation conditions" TextWrapping="Wrap"/><TextBox Text="{Binding Invalidation}" AutomationProperties.Name="Invalidation conditions" MaxLength="8000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="75"/></StackPanel>
<StackPanel Spacing="4"><TextBlock Text="Horizon" TextWrapping="Wrap"/><TextBox Text="{Binding Horizon}" AutomationProperties.Name="Horizon" MaxLength="8000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="75"/></StackPanel>
<StackPanel Spacing="4"><TextBlock Text="Peer comparability notes" TextWrapping="Wrap"/><TextBox Text="{Binding PeerNotes}" AutomationProperties.Name="Peer comparability notes" MaxLength="8000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="75"/></StackPanel>
<StackPanel Spacing="4"><TextBlock Text="User-authored conclusion" TextWrapping="Wrap"/><TextBox Text="{Binding Conclusion}" AutomationProperties.Name="User-authored conclusion" MaxLength="8000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="75"/></StackPanel>
<TextBlock Text="Frozen financial snapshot links" Classes="h2"/>
<ComboBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot}" HorizontalAlignment="Stretch" AutomationProperties.Name="Research financial snapshot"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:SnapshotChoice"><TextBlock Text="{Binding Label}" TextWrapping="Wrap"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
<WrapPanel><Button Content="Link selected snapshot" Command="{Binding LinkSnapshotCommand}" Margin="0,0,8,8"/><Button Content="Clear draft links" Command="{Binding ClearLinksCommand}" Margin="0,0,8,8"/></WrapPanel><ItemsControl ItemsSource="{Binding LinkedSnapshots}"/>
<CheckBox Content="Include explicit forecast/DCF assumptions in this revision" IsChecked="{Binding IncludeModel}"/>
<CheckBox Content="Include current rule preset in this revision" IsChecked="{Binding IncludeRules}"/>
<WrapPanel><Button Content="Save new immutable revision" Command="{Binding SaveRevisionCommand}" Classes="primary" Margin="0,0,8,8"/><Button Content="Save independent copy / scenario" Command="{Binding SaveNewCopyCommand}" Margin="0,0,8,8"/></WrapPanel>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="Rules"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="12">
<TextBlock Text="Investigation prompts, not recommendations. Thresholds/weights are editable; correlated conditions can overlap. Missing/stale/unsupported data never becomes zero or improves a rank. Choose a frozen snapshot on the Thesis tab for dated evaluation, otherwise use the in-memory comparison." TextWrapping="Wrap"/>
<ItemsControl ItemsSource="{Binding Rules}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:RuleEditor"><Border Classes="panel" Margin="0,0,0,10"><StackPanel Spacing="6">
<ComboBox ItemsSource="{Binding Metrics}" SelectedItem="{Binding Metric}" HorizontalAlignment="Stretch" AutomationProperties.Name="Rule metric"/>
<WrapPanel><ComboBox ItemsSource="{Binding Operators}" SelectedItem="{Binding Operator}" Width="80" Margin="0,0,8,8"/><StackPanel Margin="0,0,8,8"><TextBlock Text="Threshold in metric units"/><TextBox Text="{Binding Threshold}" Width="160" AutomationProperties.Name="Rule threshold"/></StackPanel><StackPanel><TextBlock Text="Weight (0–100]"/><TextBox Text="{Binding Weight}" Width="120" AutomationProperties.Name="Rule weight"/></StackPanel></WrapPanel>
</StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<WrapPanel><Button Content="Add rule" Command="{Binding AddRuleCommand}" Margin="0,0,8,8"/><Button Content="Remove last rule" Command="{Binding RemoveRuleCommand}" Margin="0,0,8,8"/><Button Content="Evaluate explicit rules" Command="{Binding EvaluateRulesCommand}" Classes="primary" Margin="0,0,8,8"/></WrapPanel>
<Button Content="Record snapshot condition review for next explicit save" Command="{Binding RecordConditionsCommand}" HorizontalAlignment="Left"/>
<TextBox Text="{Binding ScreeningOutput}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="180"/>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="Models"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="12">
<TextBlock Text="Nominal USD; user assumptions, not reported facts. Percent inputs use 10 for 10%. All amounts, dates/basis and zero claims are explicit. FCFF = after-tax EBIT + D&amp;A − capex − change in operating working capital. Losses receive no tax refund. No current-price upside or recommendations." TextWrapping="Wrap"/>
<ComboBox ItemsSource="{Binding Scenarios}" SelectedItem="{Binding Scenario}" AutomationProperties.Name="User scenario label"/>
<StackPanel Spacing="4"><TextBlock Text="Base revenue (USD)" TextWrapping="Wrap"/><TextBox Text="{Binding BaseRevenue}" AutomationProperties.Name="Base revenue (USD)" MaxLength="8000"/></StackPanel>
<StackPanel Spacing="4"><TextBlock Text="Base operating working capital (USD, signed)" TextWrapping="Wrap"/><TextBox Text="{Binding BaseWorkingCapital}" AutomationProperties.Name="Base operating working capital (USD, signed)" MaxLength="8000"/></StackPanel>
<StackPanel Spacing="4"><TextBlock Text="Historical/source basis and normalization policy" TextWrapping="Wrap"/><TextBox Text="{Binding BasisNote}" AutomationProperties.Name="Historical/source basis and normalization policy" MaxLength="8000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="75"/></StackPanel>
<TextBlock Text="Explicit years (1–10); edit every assumption" Classes="h2"/>
<ItemsControl ItemsSource="{Binding Years}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ForecastYearEditor"><Border Classes="panel" Margin="0,0,0,10"><StackPanel Spacing="8"><TextBlock Text="{Binding Year, StringFormat='Year {0}'}" FontWeight="SemiBold"/><WrapPanel><StackPanel Width="160" Margin="0,0,8,8"><TextBlock Text="Revenue growth %" TextWrapping="Wrap"/><TextBox Text="{Binding Growth}" AutomationProperties.Name="Revenue growth %"/></StackPanel><StackPanel Width="160" Margin="0,0,8,8"><TextBlock Text="Operating margin %" TextWrapping="Wrap"/><TextBox Text="{Binding Margin}" AutomationProperties.Name="Operating margin %"/></StackPanel><StackPanel Width="160" Margin="0,0,8,8"><TextBlock Text="Tax %" TextWrapping="Wrap"/><TextBox Text="{Binding Tax}" AutomationProperties.Name="Tax %"/></StackPanel><StackPanel Width="160" Margin="0,0,8,8"><TextBlock Text="D&amp;A / revenue %" TextWrapping="Wrap"/><TextBox Text="{Binding Depreciation}" AutomationProperties.Name="D&amp;A / revenue %"/></StackPanel><StackPanel Width="160" Margin="0,0,8,8"><TextBlock Text="Capex / revenue %" TextWrapping="Wrap"/><TextBox Text="{Binding Capex}" AutomationProperties.Name="Capex / revenue %"/></StackPanel><StackPanel Width="160" Margin="0,0,8,8"><TextBlock Text="OWC / revenue %" TextWrapping="Wrap"/><TextBox Text="{Binding WorkingCapital}" AutomationProperties.Name="OWC / revenue %"/></StackPanel></WrapPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><WrapPanel><Button Content="Add explicit year" Command="{Binding AddYearCommand}" Margin="0,0,8,8"/><Button Content="Remove last year" Command="{Binding RemoveYearCommand}" Margin="0,0,8,8"/></WrapPanel>
<TextBlock Text="Terminal and reviewed capital assumptions" Classes="h2"/>
<StackPanel Spacing="4"><TextBlock Text="WACC %" TextWrapping="Wrap"/><TextBox Text="{Binding Wacc}" AutomationProperties.Name="WACC %" MaxLength="8000"/></StackPanel>
<StackPanel Spacing="4"><TextBlock Text="Perpetual growth %" TextWrapping="Wrap"/><TextBox Text="{Binding TerminalGrowth}" AutomationProperties.Name="Perpetual growth %" MaxLength="8000"/></StackPanel>
<StackPanel Spacing="4"><TextBlock Text="Explicit next-year FCFF (USD)" TextWrapping="Wrap"/><TextBox Text="{Binding NextFcff}" AutomationProperties.Name="Explicit next-year FCFF (USD)" MaxLength="8000"/></StackPanel>
<StackPanel Spacing="4"><TextBlock Text="Sustainable terminal reinvestment / source policy" TextWrapping="Wrap"/><TextBox Text="{Binding TerminalPolicy}" AutomationProperties.Name="Sustainable terminal reinvestment / source policy" MaxLength="8000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="75"/></StackPanel>
<StackPanel Spacing="4"><TextBlock Text="Excess cash (USD)" TextWrapping="Wrap"/><TextBox Text="{Binding Cash}" AutomationProperties.Name="Excess cash (USD)" MaxLength="8000"/></StackPanel>
<StackPanel Spacing="4"><TextBlock Text="Other non-operating assets (USD)" TextWrapping="Wrap"/><TextBox Text="{Binding OtherAssets}" AutomationProperties.Name="Other non-operating assets (USD)" MaxLength="8000"/></StackPanel>
<StackPanel Spacing="4"><TextBlock Text="Debt (USD)" TextWrapping="Wrap"/><TextBox Text="{Binding Debt}" AutomationProperties.Name="Debt (USD)" MaxLength="8000"/></StackPanel>
<StackPanel Spacing="4"><TextBlock Text="Preferred claims (USD)" TextWrapping="Wrap"/><TextBox Text="{Binding Preferred}" AutomationProperties.Name="Preferred claims (USD)" MaxLength="8000"/></StackPanel>
<StackPanel Spacing="4"><TextBlock Text="Non-controlling claims (USD)" TextWrapping="Wrap"/><TextBox Text="{Binding Nci}" AutomationProperties.Name="Non-controlling claims (USD)" MaxLength="8000"/></StackPanel>
<StackPanel Spacing="4"><TextBlock Text="Actual common shares (individual shares)" TextWrapping="Wrap"/><TextBox Text="{Binding ActualShares}" AutomationProperties.Name="Actual common shares (individual shares)" MaxLength="8000"/></StackPanel>
<StackPanel Spacing="4"><CheckBox IsChecked="{Binding CapitalScopeConfirmed}"><TextBlock Text="I reviewed supported domestic non-financial USD scope, simple common class, complete capital claims and actual shares; unsupported structures are excluded." TextWrapping="Wrap"/></CheckBox>
<TextBlock Text="Capital / actual-share review date (yyyy-MM-dd)"/><TextBox Text="{Binding CapitalAsOf}" AutomationProperties.Name="DCF capital review date"/>
<TextBlock Text="Capital source / scope / share review note" TextWrapping="Wrap"/><TextBox Text="{Binding CapitalNote}" AutomationProperties.Name="Capital source / scope / share review note" MaxLength="8000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="75"/></StackPanel>
<Button Content="Calculate explicit forecast and DCF" Command="{Binding CalculateCommand}" Classes="primary" HorizontalAlignment="Left"/>
<CheckBox Content="Include current sensitivity/solver inputs in saved model and replayed reports" IsChecked="{Binding IncludeExploration}"/>
<Expander Header="Sensitivity and reverse DCF" HorizontalAlignment="Stretch"><StackPanel Spacing="10"><TextBlock Text="At most 100 WACC/growth cells. All other assumptions, including explicit terminal next-FCFF, remain fixed. Reverse solves one constant explicit-year revenue growth assumption; a target is your input, not a fetched quote." TextWrapping="Wrap"/><StackPanel Spacing="4"><TextBlock Text="WACC percentages, comma separated" TextWrapping="Wrap"/><TextBox Text="{Binding SensitivityWacc}" AutomationProperties.Name="WACC percentages, comma separated" MaxLength="8000"/></StackPanel>
<StackPanel Spacing="4"><TextBlock Text="Terminal growth percentages, comma separated" TextWrapping="Wrap"/><TextBox Text="{Binding SensitivityGrowth}" AutomationProperties.Name="Terminal growth percentages, comma separated" MaxLength="8000"/></StackPanel>
<TextBlock Text="Constant explicit-year revenue growth percentages, comma separated" TextWrapping="Wrap"/><TextBox Text="{Binding DriverGrowths}"/><Button Content="Evaluate revenue-growth driver" Command="{Binding RevenueSensitivityCommand}" HorizontalAlignment="Left"/>
<Button Content="Evaluate bounded sensitivity" Command="{Binding SensitivityCommand}" HorizontalAlignment="Left"/><StackPanel Spacing="4"><TextBlock Text="User target per-share assumption" TextWrapping="Wrap"/><TextBox Text="{Binding TargetPrice}" AutomationProperties.Name="User target per-share assumption" MaxLength="8000"/></StackPanel>
<StackPanel Spacing="4"><TextBlock Text="Lower revenue growth %" TextWrapping="Wrap"/><TextBox Text="{Binding LowerGrowth}" AutomationProperties.Name="Lower revenue growth %" MaxLength="8000"/></StackPanel>
<StackPanel Spacing="4"><TextBlock Text="Upper revenue growth %" TextWrapping="Wrap"/><TextBox Text="{Binding UpperGrowth}" AutomationProperties.Name="Upper revenue growth %" MaxLength="8000"/></StackPanel>
<StackPanel Spacing="4"><TextBlock Text="Absolute per-share tolerance (USD)" TextWrapping="Wrap"/><TextBox Text="{Binding Tolerance}" AutomationProperties.Name="Absolute per-share tolerance (USD)" MaxLength="8000"/></StackPanel>
<Button Content="Solve bounded constant revenue growth" Command="{Binding ReverseCommand}" HorizontalAlignment="Left"/></StackPanel></Expander>
<TextBox Text="{Binding ModelOutput}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="220" AutomationProperties.Name="Model calculation bridge"/>
<TextBlock Text="Save on the Thesis tab with Include model checked. Save independent copies to preserve Bear/Base/Bull assumptions; labels are not probabilities." TextWrapping="Wrap"/>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="Reports / changes"><ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="12">
<TextBlock Text="Reports freeze the selected saved thesis/scenario revision and linked financial snapshots. Unsaved editor changes are excluded. Full exact values/units/sources/versions and limitations are retained; no live quotes or credentials. CSV text is injection-protected; XLSX cells are explicit text without formulas." TextWrapping="Wrap"/>
<Button Content="Preview selected saved report" Command="{Binding PreviewReportCommand}" HorizontalAlignment="Left"/>
<ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding ReportFormat}"/>
<StackPanel Spacing="4"><TextBlock Text="New local output file with matching .csv, .xlsx or .pdf extension" TextWrapping="Wrap"/><TextBox Text="{Binding ReportPath}" AutomationProperties.Name="New local output file with matching .csv, .xlsx or .pdf extension" MaxLength="8000"/></StackPanel>

<Button Content="Export displayed frozen report" Command="{Binding ExportReportCommand}" Classes="primary" HorizontalAlignment="Left"/>
<TextBox Text="{Binding ReportPreview}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="300" MinHeight="100" AutomationProperties.Name="Frozen report preview"/>
<TextBlock Text="Manual monitoring and sourced fundamentals" Classes="h2"/>
<TextBlock Text="Choose newer snapshot on the Thesis tab. Choose an older snapshot below. No background polling, reminders outside this app or notifications are created. Historical valuation is blocked without point-in-time prices/shares/actions/filings and rights." TextWrapping="Wrap"/>
<ComboBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding OlderSnapshot}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:SnapshotChoice"><TextBlock Text="{Binding Label}" TextWrapping="Wrap"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
<Button Content="Compare saved snapshots" Command="{Binding CompareSnapshotsCommand}" HorizontalAlignment="Left"/>
<TextBox Text="{Binding MonitoringOutput}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140"/>
<StackPanel Spacing="4"><TextBlock Text="Issuer CIK from selected newer snapshot" TextWrapping="Wrap"/><TextBox Text="{Binding ChartCik}" AutomationProperties.Name="Issuer CIK from selected newer snapshot" MaxLength="8000"/></StackPanel>

<ComboBox ItemsSource="{Binding HistoricalMetrics}" SelectedItem="{Binding ChartMetric}"/>
<Button Content="Plot saved sourced fundamentals" Command="{Binding PlotHistoryCommand}" HorizontalAlignment="Left"/>
<TextBlock Text="{Binding ChartDomain}" TextWrapping="Wrap"/>
<ItemsControl ItemsSource="{Binding ChartSegments}" Width="560" Height="180" HorizontalAlignment="Left"><ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ChartSegment"><Polyline Points="{Binding Points}" Stroke="{DynamicResource AqAccent}" StrokeThickness="2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<TextBlock Text="{Binding ChartLabel}" TextWrapping="Wrap" Classes="muted small"/>
</StackPanel></ScrollViewer></TabItem>
</TabControl></Grid></UserControl>