<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:AlphaQuant.Desktop.ViewModels" x:Class="AlphaQuant.Desktop.Views.CompanyDetailView" x:DataType="vm:CompanyDetailViewModel">
  <Grid RowDefinitions="Auto,*" RowSpacing="20">
    <StackPanel Spacing="10">
      <TextBlock Text="Workspace / Company evidence" Classes="muted small"/>
      <Button Content="← Back to research" Command="{Binding BackCommand}" HorizontalAlignment="Left"/>
      <TextBlock Text="{Binding Title}" Classes="h1" TextWrapping="Wrap"/>
      <TextBlock Text="{Binding Subtitle}" Classes="muted"/>
    </StackPanel>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" Grid.Row="1">
      <StackPanel Spacing="18">
        <StackPanel Spacing="10" IsVisible="{Binding IsLoading}">
          <TextBlock Text="Loading annual facts from the SEC…" Classes="muted"/>
          <ProgressBar IsIndeterminate="True" Height="3"/>
          <Button Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Left"/>
        </StackPanel>
        <Border Classes="notice" IsVisible="{Binding SetupMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel Spacing="8">
            <TextBlock Text="SEC setup needed" Classes="h2"/>
            <TextBlock Text="{Binding SetupMessage}" TextWrapping="Wrap"/>
            <Button Content="Open Settings" Command="{Binding OpenSettingsCommand}" HorizontalAlignment="Left"/>
          </StackPanel>
        </Border>
        <Border Classes="notice" IsVisible="{Binding ErrorMessage, Converter={x:Static ObjectConverters.IsNotNull}}">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap"/>
            <Button Content="Retry" Command="{Binding LoadCommand}" HorizontalAlignment="Left"/>
          </StackPanel>
        </Border>
        <StackPanel Spacing="18" IsVisible="{Binding HasReport}">
          <Border Classes="notice">
            <TextBlock Text="Annual filings (10-K / 10-K/A) only · Test metric definitions (test-0) are not approved for release. Exact periods and source evidence appear below." TextWrapping="Wrap"/>
          </Border>
          <TextBlock Text="{Binding UnsupportedReason}" Classes="warning" IsVisible="{Binding UnsupportedReason, Converter={x:Static ObjectConverters.IsNotNull}}"/>
          <TextBlock Text="Latest annual facts" Classes="h2" IsVisible="{Binding HasFacts}"/>
          <ItemsControl ItemsSource="{Binding Facts}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:FactRow">
                <Border Classes="panel" Padding="18" Margin="0,0,0,12">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Value}" FontSize="23" Foreground="{DynamicResource AqAccent}"/>
                      <TextBlock Text="{Binding Period}" Classes="muted small"/>
                      <TextBlock Text="{Binding Tag}" Classes="muted small"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="6" MaxWidth="300">
                      <TextBlock Text="{Binding Form}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Filed, StringFormat='Filed {0}'}" Classes="muted small"/>
                      <TextBlock Text="{Binding Accession}" Classes="muted small"/>
                      <Button Content="Open SEC filing ↗" Command="{Binding OpenFilingCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="Test metrics · Annual" Classes="h2"/>
          <ItemsControl ItemsSource="{Binding Metrics}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MetricRow">
                <Border Classes="panel" Padding="18" Margin="0,0,0,12">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Value}" FontSize="25" Foreground="{DynamicResource AqAccent}"/>
                    <TextBlock Text="{Binding Status}" Classes="muted small"/>
                    <TextBlock Text="{Binding Version, StringFormat='Definition {0}'}" Classes="muted small"/>
                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Classes="notice" IsVisible="{Binding HasWarnings}">
            <StackPanel Spacing="10">
              <TextBlock Text="Data quality &amp; comparability" FontWeight="SemiBold"/>
              <ItemsControl ItemsSource="{Binding Warnings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding}" Classes="warning" Margin="0,0,0,8"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding RetrievedText}" Classes="muted small"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
