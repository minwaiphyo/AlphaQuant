<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="AlphaQuant.Desktop.App" RequestedThemeVariant="Default">
  <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->
  <Application.Styles>
    <FluentTheme/>
    <StyleInclude Source="avares://AlphaQuant.Desktop/Styles/ResearchTheme.axaml"/>
  </Application.Styles>
</Application>
